layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="doom" {
        pane command="emacs"
    }
    tab name="files" focus=true {
        pane size="50%" name="superfile" command="spf"
        pane size="25%" name="yazi" command="yazi"
        pane size="25%" name="xplr" command="xplr"
    }
    tab name="top" {
        pane size="50%" name="btop" command="btop"
        pane size="25%" name="htop" command="htop"
        pane size="25%" name="btm" command="btm"
    }
    tab name="containers" {
        pane size="50%" name="lazydocker" command="lazydocker"
        pane size="50%" name="oxker" command="oxker"
    }
}
