#!/usr/bin/env bash
# Unit test of lib/bws-secrets.sh against a fake `bws` and a throwaway ssh key: no network, no real token.
# Needs age, jq, openssh and coreutils on PATH (devshell: `direnv exec . tools/bws-secrets-test`).
# shellcheck disable=SC2016 # the conditions are eval'd later, on purpose
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
script=$PWD/lib/bws-secrets.sh

t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
mkdir -p "$t/bin" "$t/out" "$t/tmp"
export PATH="$t/bin:$PATH" BWS_SECRETS_TMPDIR="$t/tmp"
export BWS_SECRETS_TOKEN_FILE="$t/token" BWS_SECRETS_CACHE_DIR="$t/cache" BWS_SECRETS_HOST_KEY="$t/hostkey" BWS_SECRETS_MANIFEST="$t/manifest.json"
ssh-keygen -q -t ed25519 -N '' -f "$t/hostkey"
echo dummy-token >"$t/token"

# fake bws: `secret list -o json` for the dummy token, an error for any other token or while FAKE_BWS_OFFLINE is set
cat >"$t/bin/bws" <<'FAKE'
#!/usr/bin/env bash
[ "$*" = "secret list -o json" ] || { echo "unexpected: $*" >&2; exit 2; }
[ -z "${FAKE_BWS_OFFLINE:-}" ] || { echo "network is unreachable" >&2; exit 1; }
[ "${BWS_ACCESS_TOKEN:-}" = dummy-token ] || { echo "401 unauthorized" >&2; exit 1; }
cat "$FAKE_BWS_LIST"
FAKE
chmod +x "$t/bin/bws"

# the value of `multi` has no trailing newline and a newline inside; `dup` exists in two projects
cat >"$t/list.json" <<'JSON'
[
  {"key": "attic/auth-token", "projectId": "p1", "value": "tok-123"},
  {"key": "multi", "projectId": "p1", "value": "line1\nline2"},
  {"key": "dup", "projectId": "p1", "value": "from-p1"},
  {"key": "dup", "projectId": "p2", "value": "from-p2"}
]
JSON
export FAKE_BWS_LIST="$t/list.json"

me=$(id -un) grp=$(id -gn)
manifest() { # name:key[:project] ...
  for s in "$@"; do
    IFS=: read -r n k p <<<"$s"
    jq -n --arg n "$n" --arg k "$k" --arg p "$p" --arg path "$t/out/$n" --arg o "$me" --arg g "$grp" \
      '{name: $n, key: $k, project: (if $p == "" then null else $p end), path: $path, owner: $o, group: $g, mode: "0440"}'
  done | jq -s . >"$BWS_SECRETS_MANIFEST"
}
run() { bash "$script" "$@" 2>"$t/stderr"; }
ok=0
check() { # description, condition
  if eval "$2"; then ok=$((ok + 1)); else
    echo "FAIL: $1" >&2
    cat "$t/stderr" >&2
    exit 1
  fi
}
reset() { rm -rf "$t/out" "$t/cache" && mkdir -p "$t/out"; }

manifest attic-auth-token:attic/auth-token multi:multi
run sync
check "sync installs the value" '[ "$(cat "$t/out/attic-auth-token")" = tok-123 ]'
check "values are byte-exact (no trailing newline added)" '[ "$(wc -c <"$t/out/multi")" = 11 ] && [ "$(head -c 5 "$t/out/multi")" = line1 ]'
check "mode, owner and group are applied" '[ "$(stat -c "%a %U %G" "$t/out/attic-auth-token" 2>/dev/null || stat -f "%Lp %Su %Sg" "$t/out/attic-auth-token")" = "440 $me $grp" ]'
check "the cache is age-encrypted" '[ "$(head -c 21 "$t/cache/attic-auth-token.age")" = age-encryption.org/v1 ] && ! grep -rq tok-123 "$t/cache"'
check "no plaintext is left in the work dir" '[ -z "$(ls -A "$t/tmp")" ]'

rm "$t/out"/*
run restore
check "restore installs from the cache with no bws and no token" '[ "$(cat "$t/out/attic-auth-token")" = tok-123 ]'

rm "$t/out"/*
FAKE_BWS_OFFLINE=1 run sync && check "offline sync exits 1" false || true
check "offline sync still installs from the cache" '[ "$(cat "$t/out/attic-auth-token")" = tok-123 ] && grep -q "fetch failed" "$t/stderr"'

rm "$t/out"/*
echo wrong-token >"$t/token"
run sync && check "a rejected token exits 1" false || true
check "a rejected token falls back to the cache" '[ "$(cat "$t/out/attic-auth-token")" = tok-123 ] && grep -q 401 "$t/stderr"'
rm "$t/token"
run sync && check "a missing token exits 1" false || true
check "a missing token reports it and falls back to the cache" '[ -e "$t/out/multi" ] && grep -q "no machine token" "$t/stderr"'
echo dummy-token >"$t/token"

reset
FAKE_BWS_OFFLINE=1 run sync && check "no cache and offline exits 1" false || true
check "nothing is installed without a cache" '[ -z "$(ls -A "$t/out")" ] && grep -q "not fetched and not cached" "$t/stderr"'
run restore
check "restore with no cache is quiet and succeeds" '[ -z "$(ls -A "$t/out")" ] && [ ! -s "$t/stderr" ]'

reset
manifest attic-auth-token:attic/auth-token gone:does/not/exist
run sync && check "a secret missing from Bitwarden exits 1" false || true
check "the other secrets are still installed" '[ "$(cat "$t/out/attic-auth-token")" = tok-123 ] && [ ! -e "$t/out/gone" ] && grep -q "0 secrets named does/not/exist" "$t/stderr"'

reset
manifest dup:dup
run sync && check "an ambiguous name exits 1" false || true
check "an ambiguous name installs nothing" '[ ! -e "$t/out/dup" ] && grep -q "2 secrets named dup" "$t/stderr"'
manifest dup:dup:p2
run sync
check "a project id disambiguates" '[ "$(cat "$t/out/dup")" = from-p2 ]'

reset
manifest nodir:attic/auth-token
jq '.[0].path = "'"$t"'/missing/dir/x"' "$BWS_SECRETS_MANIFEST" >"$t/m2.json" && mv "$t/m2.json" "$BWS_SECRETS_MANIFEST"
run sync && check "a path whose directory is missing exits 1" false || true
check "the missing directory is reported, not created" '[ ! -d "$t/missing" ] && grep -q "does not exist" "$t/stderr"'

echo "bws-secrets-test: $ok checks passed"
